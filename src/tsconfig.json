/*
 * The editor's half of `src`, tests included: the options `npm run typecheck` runs over it, the
 * file an editor resolves a component against, and the one Vite reads `jsx` and `jsxImportSource`
 * from when it transforms a `.cmp.test.tsx`. A test file that is not covered here is transformed
 * with esbuild's default JSX instead and every render fails with `Invalid vNode child undefined`.
 * That is why this file sits in `src/` rather than at the repository root: the root
 * `tsconfig.json` is the plugin's, it has no JSX settings at all, and Vite takes the nearest one.
 *
 * Stencil builds the editor with the root `tsconfig.stencil.json`, which is this file with the
 * tests taken back out, because everything Stencil compiles is published in `dist/collection`.
 *
 * The excluded paths are the Capacitor plugin and the storage its web implementations run on, which
 * the root `tsconfig.json` compiles into `plugin/` under its own rules. `editor/` is deliberately
 * not among them: the contract is the one thing both halves share, and the components read it from
 * `../editor` the way the proxies read it from `./editor`.
 *
 * `mcp/` is excluded for a harder reason than "it is a different build". It imports
 * `@modelcontextprotocol/sdk`, which is an OPTIONAL peer dependency, so on a consumer that has not
 * installed it the specifier does not resolve at all. Left in this program, every editor build and
 * every `npm run typecheck` on such a checkout fails with a TS2307 pointing at a package the
 * consumer was never asked to install - and worse, Stencil copies everything it compiles into
 * `dist/collection`, so an app bundling the editor would be bundling a tool server it has no use
 * for. `tsconfig.mcp.json` compiles it instead, and only when it is asked to.
 */
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    /* Stencil's decorators are the legacy TypeScript ones, not the TC39 standard ones. */
    "experimentalDecorators": true,
    /*
     * The automatic JSX runtime, supported since @stencil/core 4.41.0, so no file needs an `h`
     * import. That matters more than it sounds: `noUnusedLocals` in the base config plus Stencil's
     * "always fail the build on a TypeScript error" turns a left over `h` import into a build
     * failure whose message reads like a JSX runtime problem and is not one.
     */
    "jsx": "react-jsx",
    "jsxImportSource": "@stencil/core",
    "rootDir": "./",
    "types": ["@stencil/vitest/globals"]
  },
  "include": ["."],
  "exclude": ["plugin.ts", "video-composer", "post-publisher", "web-runtime", "mcp", "node_modules"]
}
