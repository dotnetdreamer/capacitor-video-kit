{
  "name": "@capacitor-video-kit/react",
  "version": "1.3.0",
  "description": "React bindings for the Capacitor Video Kit editor, published as capacitor-video-kit/react",
  "license": "UNLICENSED",
  "author": "Globaegis Limited FZE",
  "type": "module",
  "scripts": {
    "build": "rimraf ../../react .build && tsc --project tsconfig.json && rollup --config rollup.config.mjs",
    "watch": "tsc --project tsconfig.json --watch --preserveWatchOutput & rollup --config rollup.config.mjs --watch & wait",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "clean": "rimraf ../../react .build src/generated"
  },
  "dependencies": {
    "@stencil/core": "^4.45.0"
  },
  "peerDependencies": {
    "capacitor-video-kit": "1.3.0",
    "@preact/signals-core": "^1.14.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@preact/signals-core": "^1.14.4",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@stencil/react-output-target": "^1.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1"
  },
  "private": true
}
