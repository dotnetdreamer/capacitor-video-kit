{
  "name": "choisy-video-kit-react",
  "version": "1.3.0",
  "description": "React bindings for the Choisy video editor",
  "license": "UNLICENSED",
  "author": "Globaegis Limited FZE",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rimraf dist .build && tsc --project tsconfig.json && rollup --config rollup.config.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "clean": "rimraf dist .build src/generated"
  },
  "dependencies": {
    "@stencil/core": "^4.45.0",
    "choisy-video-kit": "1.3.0"
  },
  "peerDependencies": {
    "@preact/signals-core": "^1.14.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@preact/signals-core": "^1.14.4",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@stencil/react-output-target": "^1.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1"
  },
  "sideEffects": false
}
