/*
 * `module: esnext` and `moduleResolution: bundler` are both required rather than preferred: the
 * generated wrappers import the custom elements through the core package's exports map, which
 * older resolution modes do not read.
 *
 * `tsc` writes `.build` rather than `dist`, because it is the first half of the build: Rollup
 * bundles what lands there into `dist`. `rollup.config.mjs` says why that step exists.
 *
 * No maps of either kind, because `files` is `dist/` and the sources a map names are `src/`, which
 * is not in the tarball. A map to a file the consumer does not have is worse than no map: a
 * debugger stops showing the shipped JavaScript and reports a missing source instead.
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": ".build",
    "rootDir": "src",
    /*
     * The generated wrappers import their `Ve*CustomEvent` types from the bare package name, which
     * the React output target hard codes and offers no option to point elsewhere. In this package
     * the root is the Capacitor plugin and the editor lives on the `./ui` subpath, so that bare
     * specifier resolves to `plugin/esm/plugin.d.ts`, which knows nothing about components. The
     * first component with an `@Event()` is what made that visible.
     *
     * This is half of the answer and it is the half that only helps here: it lets `tsc` read the
     * wrappers, and a consumer never sees it. `rollup.config.mjs` is the other half, rewriting that
     * same specifier in the shipped declarations to `choisy-video-kit/dist/components`, which is the
     * file named below and the one the exports map resolves. The two are deliberately the same file,
     * so the types this package is built against are the types a consumer compiles.
     */
    "paths": {
      "choisy-video-kit": ["../../dist/components/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
