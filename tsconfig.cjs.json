{
  /* The CommonJS half of the plugin build. Bundlers and Node ESM take `plugin/esm`; this exists so
     a `require('capacitor-video-kit')` from an older toolchain still resolves to real JavaScript. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "plugin/cjs"
  }
}
