{
  "name": "choisy-video-kit",
  "version": "1.2.3",
  "description": "Native video composition and native background publishing for Capacitor: edit and encode on the device, then upload in a way that survives the app being killed.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/esm/editor/index.d.ts",
        "default": "./dist/esm/editor/index.js"
      },
      "require": {
        "types": "./dist/cjs/editor/index.d.ts",
        "default": "./dist/cjs/editor/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "license": "UNLICENSED",
  "private": true,
  "files": [
    "dist/"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "video",
    "editor",
    "transformer",
    "upload",
    "background",
    "workmanager"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/finish-build.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    }
  }
}
