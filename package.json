{
  "name": "choisy-video-kit",
  "version": "1.3.0",
  "description": "Native video composition and native background publishing for Capacitor, and the editor that drives them as framework free web components: edit and encode on the device, then upload in a way that survives the app being killed.",
  "license": "UNLICENSED",
  "author": "Globaegis Limited FZE",
  "private": true,
  "main": "plugin/cjs/plugin.js",
  "module": "plugin/esm/plugin.js",
  "types": "plugin/esm/plugin.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/choisy-video-kit/choisy-video-kit.esm.js",
  "sideEffects": [
    "dist/**",
    "loader/**"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./plugin/esm/plugin.d.ts",
        "default": "./plugin/esm/plugin.js"
      },
      "require": {
        "types": "./plugin/cjs/plugin.d.ts",
        "default": "./plugin/cjs/plugin.js"
      }
    },
    "./editor": {
      "import": {
        "types": "./plugin/esm/editor/index.d.ts",
        "default": "./plugin/esm/editor/index.js"
      },
      "require": {
        "types": "./plugin/cjs/editor/index.d.ts",
        "default": "./plugin/cjs/editor/index.js"
      }
    },
    "./mcp": {
      "import": {
        "types": "./mcp/mcp/index.d.ts",
        "default": "./mcp/mcp/index.js"
      }
    },
    "./ui": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./assets/*": "./dist/components/assets/*",
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.mjs",
      "require": "./loader/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/",
    "dist/",
    "loader/",
    "ios/Sources/",
    "Package.swift",
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "mcp/**",
    "!dist/collection/assets"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "video",
    "editor",
    "transformer",
    "upload",
    "background",
    "workmanager",
    "stencil",
    "web-components"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "workspaces": [
    "packages/react",
    "packages/vue",
    "packages/angular"
  ],
  "scripts": {
    "build": "npm run build:package && npm run build:wrappers",
    "build:package": "npm run clean && npm run build:plugin && npm run build:ui && npm run build:mcp && node scripts/module-type.mjs",
    "build:plugin": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finish-build.mjs",
    "build:ui": "stencil build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:wrappers": "npm run build --workspace choisy-video-kit-react && npm run build --workspace choisy-video-kit-vue && npm run build --workspace choisy-video-kit-angular",
    "clean": "rimraf plugin dist loader mcp www .stencil .stencil-test-build src/components.d.ts",
    "dev": "stencil build --dev --watch --serve --config stencil.dev.config.ts",
    "watch": "npm run watch:ui & npm run watch:plugin & wait",
    "watch:ui": "stencil build --watch --config stencil.watch.config.ts",
    "watch:plugin": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "watch:angular": "npm run build --workspace choisy-video-kit-angular -- --watch",
    "example": "node examples/plain-web/serve.mjs",
    "prepare": "npm run build:package",
    "test": "stencil-test --prod --stencil-config stencil.test.config.ts",
    "test:watch": "stencil-test --prod --watch --stencil-config stencil.test.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.mcp-tests.json && tsc -p tsconfig.plugin-tests.json && tsc -p src/tsconfig.json --noEmit && tsc -p tsconfig.tools.json && npm run typecheck --workspaces",
    "generate": "stencil generate",
    "clean:all": "npm run clean && npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@preact/signals-core": "^1.14.4",
    "@stencil/angular-output-target": "^1.5.0",
    "@stencil/core": "^4.45.0",
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/vitest": "^1.15.1",
    "@stencil/vue-output-target": "0.14.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "capacitor-core-build": "npm:@capacitor/core@^8.0.2",
    "choisy-video-kit": "file:.",
    "playwright": "^1.52.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@preact/signals-core": "^1.14.4",
    "@stencil/core": "^4.45.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@preact/signals-core": {
      "optional": true
    },
    "@stencil/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "mediabunny": "^1.58.0"
  }
}
