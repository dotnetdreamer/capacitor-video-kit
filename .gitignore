node_modules/

# The build outputs. `plugin/` is the Capacitor plugin's `tsc` pair, `dist/` and `loader/` are
# Stencil's.
/plugin/
dist/
loader/
www/
.stencil/

# The three framework wrappers, built from `packages/<framework>` into the root so that the exports
# map can offer them as `capacitor-video-kit/<framework>`. Anchored, because `react` and `vue`
# are ordinary words and an unanchored rule would swallow a source directory that ever takes one of
# those names.
/angular/
/react/
/vue/

# The MCP server's `tsc` output, written by scripts/build-mcp.mjs. Anchored, so that `src/mcp/`,
# which is the source and IS tracked, is not caught by it. The build only produces this directory
# when @modelcontextprotocol/sdk is installed, so on most checkouts there is nothing here at all.
/mcp/

# What `npm test` builds into. It is a whole Stencil build, kept away from the published tree so
# that a test run cannot leave `dist/` half written. See stencil.test.config.ts.
.stencil-test-build/

# Written by `stencil build`, every time, from the components themselves.
src/components.d.ts

# Written into the wrapper packages by stencil.config.ts. The wrappers are generated from the
# components, so the only thing worth reviewing is the component that produced them.
packages/*/src/generated/
packages/react/.build/
packages/angular/.angular/

# Only written when a browser test fails.
__screenshots__/
.vitest-attachments/

# JavaScript emitted BESIDE a TypeScript source, which nothing in this repository wants and every
# build here is configured not to produce. It turns up anyway when a `tsc -p` is pointed at a config
# it cannot parse: TypeScript reports the parse error, falls back to compiling the working directory
# with default options, and leaves a `.js` next to all six hundred sources. Those files then shadow
# their own sources - Vitest resolves `./thing` to the stale `thing.js` - so the symptom is a suite
# that fails in modules nobody touched. Ignoring them keeps that accident out of a commit; `git
# clean -n` is how to find them.
src/**/*.js
src/**/*.js.map
build/**/*.js
packages/*/src/*.js

# The packed tarballs. `npm pack` writes them here and a consumer installs them from a path; they
# are a build output like any other and a new one lands on every version.
*.tgz

android/build/
android/.gradle/

# SwiftPM build output. `swift build` and `xcodebuild` both drop these next to Package.swift
# when the package is resolved on its own; the app's CapApp-SPM is what pins versions for a build.
.build/
.swiftpm/
Package.resolved

*.log
.DS_Store
.idea/
.vscode/
